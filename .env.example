# --- Supabase (already set up for you) ---
SUPABASE_URL=https://auuwmcgbonwivkhhmpxw.supabase.co
# Dashboard > Project Settings > API Keys > service_role (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ---
# Who receives the daily digest
EMAIL_TO=you@example.com

# Provider: "resend" (default) or "gmail"
EMAIL_PROVIDER=resend

# Resend (https://resend.com) - free tier sends to your own verified email
RESEND_API_KEY=
# Optional: defaults to onboarding@resend.dev which works without a domain
EMAIL_FROM=

# Gmail SMTP (only if EMAIL_PROVIDER=gmail)
# Create an app password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- USAJobs (https://developer.usajobs.gov/apirequest/) ---
USAJOBS_API_KEY=
# USAJobs requires your email as the User-Agent
USAJOBS_USER_AGENT=you@example.com
